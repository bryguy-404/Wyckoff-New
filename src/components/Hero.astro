---
import { contentImageSize } from "../lib/contentImages";
import pageContent from "../data/pages/home.json";
const content = pageContent.hero;
const heroVideo = "/videos/luke-wyckoff-hero.mp4";
---
<header class="hero" id="top">
  <div class="hero__media" aria-hidden="true">
    <img class="hero__fallback" src={content.fallbackSrc} alt="" fetchpriority="high" {...await contentImageSize(content.fallbackSrc)} />
    <video class="hero__video" id="heroVideo" autoplay muted loop playsinline preload="metadata"
      poster={content.videoPoster}>
      <source src={heroVideo} type="video/mp4" />
    </video>
  </div>
  <div class="hero__wash" aria-hidden="true"></div>
  <div class="hero__grain" aria-hidden="true"></div>

  <div class="hero__inner wrap" id="heroInner">
    <p class="hero__kicker">{content.kicker}</p>
    <h1 class="display display--xl">
      <span class="ln"><span>{content.headingLine1} </span></span>
      <span class="ln"><span>{content.headingLine2} </span></span>
      <span class="ln"><span class="soft">{content.headingLine3} </span></span>
      <span class="ln"><span class="soft">{content.headingLine4}</span></span>
    </h1>
    <div class="hero__foot">
      <p class="hero__sub">{content.sub}</p>
      <a class="textlink" href={content.linkHref}>{content.linkLabel}</a>
    </div>
  </div>
</header>
