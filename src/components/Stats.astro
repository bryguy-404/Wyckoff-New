---
import pageContent from "../data/pages/home.json";
const content = pageContent.stats;
import { fromContentSlots } from "../lib/contentSlots";
const stats = fromContentSlots(content.stats);
---
<section class="wrap band band--tan rv">
  <p class="label">{content.paragraph}</p>
  <h2 class="display display--sm" style="max-width:17ch">{content.heading}</h2>
  <div class="stats">
    {stats.map((s) => (
      <div class="stat">
        <span class="stat__n" data-count={s.count} data-suffix={s.suffix || undefined}>0</span>
        <span class="stat__l">{s.label}</span>
      </div>
    ))}
  </div>
</section>
