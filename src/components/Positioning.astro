---
import pageContent from "../data/pages/home.json";
const content = pageContent.positioning;
---
<section class="wrap band rv">
  <div class="split">
    <div>
      <p class="label">{content.paragraph}</p>
      <h2 class="display wordrise">{content.heading}</h2>
    </div>
    <div class="positioning__copy">
      <p class="lede">{content.paragraph2}</p>
      <p class="lede" style="margin-top:1.6rem">{content.paragraph3}</p>
    </div>
  </div>
</section>

<style>
  .positioning__copy {
    align-self: center;
    text-align: left;
  }

  @media (max-width: 960px) {
    .positioning__copy {
      align-self: auto;
    }
  }
</style>
