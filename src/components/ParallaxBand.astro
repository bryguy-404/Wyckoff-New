---
import { contentImageSize } from "../lib/contentImages";
import pageContent from "../data/pages/home.json";
const content = pageContent.parallaxBand;
---
<div class="plxband" aria-hidden="true">
  <img data-plx="0.16" src={content.src} alt="" loading="lazy" {...await contentImageSize(content.src)} />
  <div class="plxband__cap">{content.cap}</div>
</div>
