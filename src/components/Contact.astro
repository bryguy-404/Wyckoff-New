---
import pageContent from "../data/pages/shared.json";
const content = pageContent.contact;
const revenueOptions = ["$3M – $10M", "$10M – $25M", "$25M – $50M", "$50M+"];
---
<section class="band band--ink" id="contact">
  <div class="wrap contact__grid">
    <div class="rv">
      <p class="label">{content.eyebrow}</p>
      <h2 class="display" style="max-width:11ch">{content.heading}</h2>
      <p class="lede" style="margin-top:2rem">{content.intro}</p>
    </div>
    <form class="rv" id="contactForm" data-messages={JSON.stringify(content.messages)} method="post" action="/api/contact" novalidate>
      <div class="field"><label for="f-name">{content.nameLabel}</label><input id="f-name" name="name" type="text" autocomplete="name" required /></div>
      <div class="field"><label for="f-co">{content.companyLabel}</label><input id="f-co" name="company" type="text" autocomplete="organization" /></div>
      <div class="field"><label for="f-email">{content.emailLabel}</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
      <div class="field"><label for="f-rev">{content.revenueLabel}</label>
        <select id="f-rev" name="revenue">
          <option value="">{content.revenuePlaceholder}</option>
          {revenueOptions.map((opt) => <option value={opt}>{opt}</option>)}
        </select>
      </div>
      <div class="field"><label for="f-what">{content.messageLabel}</label><textarea id="f-what" name="message" rows="3" required></textarea></div>
      <div class="hp-field" aria-hidden="true">
        <label for="f-website" tabindex="-1">Leave this field empty</label>
        <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <button class="submit" type="submit"><span>{content.submitLabel}</span></button>
      <p class="formstatus" id="formStatus" role="status" aria-live="polite"></p>
      <p class="formnote">{content.privacyNote}</p>
    </form>
  </div>
</section>

<script is:inline>
(function(){
  var form=document.getElementById('contactForm');
  if(!form) return;
  var messages=JSON.parse(form.dataset.messages);
  var submitLabel=form.querySelector('.submit span').textContent;
  var status=document.getElementById('formStatus');
  var btn=form.querySelector('.submit');
  var btnText=btn.querySelector('span');
  form.addEventListener('submit',function(ev){
    ev.preventDefault();
    var data={};
    new FormData(form).forEach(function(v,k){ data[k]=v; });
    if(!data.name || !data.email || !data.message){
      status.classList.add('err');
      status.textContent=messages.required;
      return;
    }
    btn.disabled=true; btnText.textContent=messages.sending;
    status.classList.remove('err'); status.textContent='';
    fetch('/api/contact',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify(data)
    }).then(function(res){
      return res.json().catch(function(){return {};}).then(function(out){
        if(res.ok){
          form.reset();
          status.textContent=messages.success;
        }else{
          status.classList.add('err');
          status.textContent=out.error||messages.failure;
        }
      });
    }).catch(function(){
      status.classList.add('err');
      status.textContent=messages.network;
    }).finally(function(){
      btn.disabled=false; btnText.textContent=submitLabel;
    });
  });
})();
</script>
