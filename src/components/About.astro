---
import { contentImageSize } from "../lib/contentImages";
import sharedContent from "../data/pages/shared.json";
import pageContent from "../data/pages/home.json";
const content = pageContent.about;
import { fromContentSlots } from "../lib/contentSlots";
import ExternalArrow from "./ExternalArrow.astro";
import LinkedInIcon from "./LinkedInIcon.astro";

const facts = fromContentSlots(content.facts);
---
<section class="wrap band" id="about">
  <p class="label rv">{content.paragraph}</p>
  <h2 class="about2__name rv">{content.name} <span class="surname">{content.text}</span></h2>
  <div class="about2__grid">
    <figure class="about2__figure">
      <div class="about2__media" id="aboutMedia">
        <img
          src={sharedContent.business.portrait.src}
          alt={sharedContent.business.portrait.alt}
          loading="lazy"
          decoding="async"
        {...await contentImageSize(sharedContent.business.portrait.src)} />
        <span class="about2__tint" aria-hidden="true"></span>
        <figcaption class="about2__quote">{content.quote}</figcaption>
      </div>
      <span class="about2__side" aria-hidden="true">{content.side}</span>
    </figure>
    <div class="about2__body rv">
      <p>{content.paragraph2}</p>
      <p>{content.paragraph3}</p>
      <div class="about2__facts">
        {facts.map((f) => (
          <div class="about2__fact"><span class="about2__fact-value">{f.value}</span><span class="about2__fact-label">{f.label}</span></div>
        ))}
      </div>
      <div class="about2__prompt">
        <a class="textlink" href={sharedContent.business.linkedInUrl} target="_blank" rel="noopener noreferrer">
          <LinkedInIcon />
          <span>{content.text2}</span>
          <ExternalArrow />
          <span class="sr-only"> {content.text3}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about2__prompt {
    margin-top: 2rem;
  }

  .about2__prompt .textlink {
    align-items: flex-start;
    max-width: 100%;
    line-height: 1.45;
    white-space: normal;
  }

  .about2__prompt .textlink > :global(svg) {
    flex: none;
    margin-top: 0.05em;
  }
</style>
