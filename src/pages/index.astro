---
import pageContent from "../data/pages/home.json";
const content = pageContent.page;
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TaglineMarquee from "../components/TaglineMarquee.astro";
import Positioning from "../components/Positioning.astro";
import ParallaxBand from "../components/ParallaxBand.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import InflectionPoints from "../components/InflectionPoints.astro";
import Stats from "../components/Stats.astro";
import About from "../components/About.astro";
import Statement from "../components/Statement.astro";
import Testimonials from "../components/Testimonials.astro";
import Contact from "../components/Contact.astro";
import { clientLogos } from "../data/logos";
---
<Layout>
  <Hero />
  <TaglineMarquee />
  <Positioning />
  <ParallaxBand />
  <LogoMarquee
    id="past-clients"
    visibleLabel={content.visibleLabel}
    accessibleLabel={content.accessibleLabel}
    logos={clientLogos}
  />
  <InflectionPoints />
  <Stats />
  <About />
  <Statement />
  <Testimonials />
  <Contact />
</Layout>
