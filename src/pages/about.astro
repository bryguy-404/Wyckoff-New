---
import { contentImageSize } from "../lib/contentImages";
import sharedContent from "../data/pages/shared.json";
import pageContent from "../data/pages/about.json";
const content = pageContent;
import { fromContentSlots } from "../lib/contentSlots";
import Layout from "../layouts/Layout.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import ResultsShowcase from "../components/ResultsShowcase.astro";
import { guestLectureLogos } from "../data/logos";

const expectations = fromContentSlots(content.expectations.expectations);

const industries = fromContentSlots(content.industries.industries);
---

<Layout
  title={content.seo.title}
  description={content.seo.description}
>
  <section class="about-hero" id="top" aria-labelledby="about-title">
    <div class="about-hero__glow" aria-hidden="true"></div>
    <div class="wrap about-hero__grid" id="aboutHeroInner">
      <div class="about-hero__copy">
        <p class="about-hero__eyebrow">{content.hero.eyebrow}</p>
        <h1 class="about-hero__title" id="about-title">
          <span class="about-hero__sentence"><span class="about-hero__title-line">{content.hero.titleLine}</span> <span class="about-hero__title-line">{content.hero.titleLine2}</span></span>
          <span class="about-hero__sentence about-hero__title-soft"><span class="about-hero__title-line">{content.hero.titleLine3}</span> <span class="about-hero__title-line">{content.hero.titleLine4}</span></span>
        </h1>
        <p class="about-hero__lede">
          {content.hero.lede}
        </p>
        <a class="textlink about-hero__link" href={content.hero.linkHref}>{content.hero.link} <span aria-hidden="true">&darr;</span></a>
      </div>

      <figure class="about-hero__portrait">
        <div class="about-hero__portrait-frame">
          <img
            src={sharedContent.business.portrait.src}
            alt={sharedContent.business.portrait.alt}
            fetchpriority="high"
            decoding="async"
          {...await contentImageSize(sharedContent.business.portrait.src)} />
        </div>
        <figcaption>
          <span>{content.hero.text}</span>
          <span>{content.hero.text2}</span>
        </figcaption>
      </figure>
    </div>

    <div class="wrap about-hero__proof" aria-label="Luke Wyckoff's experience at a glance">
      <div><strong>{content.hero.emphasis}</strong><span>{content.hero.text3}</span></div>
      <div><strong>{content.hero.emphasis2}</strong><span>{content.hero.text4}</span></div>
      <div><strong>{content.hero.countriesValue}</strong><span>{content.hero.text5}</span></div>
    </div>
  </section>

  <section class="perspective" aria-labelledby="perspective-title">
    <div class="wrap perspective__intro">
      <p class="label rv">{content.perspective.paragraph}</p>
      <div class="perspective__headline rv">
        <h2 class="display" id="perspective-title"><span class="about-heading__line">{content.perspective.line}</span> <span class="about-heading__line">{content.perspective.line2}</span> <span class="about-heading__line">{content.perspective.line3}</span> <span class="about-heading__line">{content.perspective.line4}</span></h2>
        <p class="perspective__standfirst">{content.perspective.standfirst}</p>
      </div>
    </div>

    <div class="wrap perspective__story">
      <div class="perspective__copy rv">
        <p>{content.perspective.paragraph2}</p>
        <p>{content.perspective.paragraph3} <strong>{content.perspective.emphasis3}</strong>.</p>
        <p>{content.perspective.paragraph4}</p>
        <p>{content.perspective.paragraph5}</p>
      </div>

      <aside class="perspective__principle rv" aria-label="Wyckoff Consulting principle">
        <span aria-hidden="true">{content.perspective.text6}</span>
        <p>{content.perspective.paragraph6}</p>
        <strong>{content.perspective.emphasis4}</strong>
      </aside>
    </div>

    <div class="wrap industries rv">
      <div class="industries__heading">
        <p class="label">{content.industries.paragraph7}</p>
        <p>{content.industries.paragraph8}</p>
      </div>
      <ol class="industries__list">
        {industries.map((industry, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span>{industry}</li>
        ))}
      </ol>
      <p class="industries__closing">{content.industries.closing} <strong>{content.industries.emphasis5}</strong>{content.industries.closing2}</p>
    </div>
  </section>

  <section class="about-leadership band" id="executive-leadership" aria-labelledby="leadership-title">
    <div class="wrap about-leadership__grid">
      <div class="about-leadership__heading rv">
        <p class="label">{content.leadership.paragraph9}</p>
        <h2 class="display" id="leadership-title"><span class="about-heading__line">{content.leadership.line5}</span> <span class="about-heading__line">{content.leadership.line6}</span> <span class="about-heading__line">{content.leadership.line7}</span></h2>
      </div>
      <div class="about-leadership__body rv">
        <p class="about-leadership__opening">{content.leadership.opening}</p>
        <p>{content.leadership.paragraph10}</p>
        <p>{content.leadership.paragraph11}</p>
        <p>{content.leadership.paragraph12}</p>
      </div>
    </div>
  </section>

  <section class="expectations band" aria-labelledby="expectations-title">
    <div class="wrap">
      <div class="expectations__heading rv">
        <p class="label">{content.expectations.paragraph13}</p>
        <h2 class="display" id="expectations-title"><span class="about-heading__line">{content.expectations.line8}</span> <span class="about-heading__line">{content.expectations.line9}</span> <span class="about-heading__line">{content.expectations.line10}</span></h2>
        <p>{content.expectations.paragraph14}</p>
      </div>

      <ol class="expectations__grid">
        {expectations.map((expectation, index) => (
          <li class="expectation rv">
            <span class="expectation__number">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{expectation.title}</h3>
              <p>{expectation.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <LogoMarquee
    id="guest-lectures"
    visibleLabel={content.lectures.visibleLabel}
    accessibleLabel={content.lectures.accessibleLabel}
    logos={guestLectureLogos}
    externalCta={content.lectures.keynoteLink}
    featureImage={content.lectures.speakingImage}
  />

  <ResultsShowcase />
</Layout>

<style>
  .about-hero {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100svh;
    overflow: hidden;
    background: var(--ink);
    color: var(--cream);
    padding-top: clamp(5.75rem, 12svh, 8rem);
  }

  #executive-leadership,
  :global(#guest-lectures),
  :global(#annual-results) {
    scroll-margin-top: 6rem;
  }

  .about-hero__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 86% 20%, color-mix(in srgb, var(--sage-lt) 24%, transparent), transparent 30%),
      linear-gradient(125deg, transparent 48%, color-mix(in srgb, var(--sage) 18%, transparent));
  }

  .about-hero__glow::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: .08;
    background-image: radial-gradient(circle, var(--cream) 1px, transparent 1px);
    background-size: 22px 22px;
    -webkit-mask-image: linear-gradient(90deg, transparent 35%, black);
    mask-image: linear-gradient(90deg, transparent 35%, black);
  }

  .about-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(20rem, .78fr);
    min-height: 0;
    gap: clamp(2.5rem, 7vw, 8rem);
    align-items: center;
  }

  .about-hero__copy {
    padding-block: clamp(.75rem, 2svh, 1.5rem);
  }

  .about-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 clamp(.75rem, 2svh, 1.35rem);
    color: var(--sage-pale);
    font-size: var(--micro-size);
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  .about-hero__eyebrow::before {
    content: "";
    width: clamp(2.5rem, 5vw, 5rem);
    height: 2px;
    background: var(--amber);
  }

  .about-hero__title {
    margin: 0;
    max-width: 15ch;
    font-size: clamp(2.4rem, min(4.6vw, 8.8svh), 5.6rem);
    font-weight: 600;
    letter-spacing: -.055em;
    line-height: .9;
    text-wrap: balance;
  }

  .about-hero__sentence {
    display: block;
  }

  .about-hero__title-line,
  .about-heading__line {
    display: inline;
  }

  .about-hero__title-soft {
    color: var(--sage-pale);
    font-weight: 400;
  }

  .about-hero__lede {
    max-width: 42ch;
    margin: clamp(.9rem, 2.4svh, 1.6rem) 0 0;
    font-size: clamp(.94rem, 1.15vw, 1.1rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--cream) 86%, transparent);
  }

  .about-hero__link {
    margin-top: clamp(.9rem, 2.4svh, 1.6rem);
  }

  .about-hero__portrait {
    position: relative;
    width: min(100%, clamp(17.6rem, 53.6svh, 30.4rem));
    height: auto;
    aspect-ratio: 4 / 5;
    margin: 0;
    align-self: center;
    justify-self: end;
  }

  .about-hero__portrait::before {
    content: "";
    position: absolute;
    inset: 8% -5% -2% 9%;
    border: 1px solid color-mix(in srgb, var(--cream) 18%, transparent);
    transform: translate(1.25rem, 1.25rem);
  }

  .about-hero__portrait-frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    background: var(--cream);
    border-left: 3px solid var(--amber);
  }

  .about-hero__portrait-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, color-mix(in srgb, var(--ink) 30%, transparent));
    pointer-events: none;
  }

  .about-hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(.88) contrast(1.03);
  }

  .about-hero__portrait figcaption {
    position: absolute;
    left: clamp(1rem, 2vw, 1.7rem);
    right: clamp(1rem, 2vw, 1.7rem);
    bottom: clamp(1rem, 2vw, 1.7rem);
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: .8rem;
    border-top: 1px solid color-mix(in srgb, var(--cream) 42%, transparent);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .14em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .about-hero__proof {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 0;
    border-top: 1px solid color-mix(in srgb, var(--cream) 18%, transparent);
  }

  .about-hero__proof > div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(.8rem, 2vw, 1.5rem);
    align-items: center;
    padding: clamp(.8rem, 1.8svh, 1.25rem) clamp(1rem, 2.3vw, 2rem);
    border-right: 1px solid color-mix(in srgb, var(--cream) 18%, transparent);
  }

  .about-hero__proof > div:first-child { padding-left: 0; }
  .about-hero__proof > div:last-child { border-right: 0; }

  .about-hero__proof strong {
    font-size: clamp(2rem, min(3.5vw, 5svh), 3.5rem);
    font-weight: 600;
    letter-spacing: -.055em;
    line-height: 1;
    color: var(--sage-pale);
  }

  .about-hero__proof span {
    max-width: 14ch;
    font-size: clamp(.72rem, .9vw, .9rem);
    font-weight: 700;
    letter-spacing: .14em;
    line-height: 1.45;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cream) 78%, transparent);
  }

  .about-leadership__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: start;
  }

  .about-leadership__heading {
    position: sticky;
    top: 8rem;
  }

  .about-leadership__heading h2 {
    max-width: 14ch;
    font-size: clamp(2.65rem, 3.8vw, 4.25rem);
    line-height: .98;
    letter-spacing: -.04em;
    text-wrap: balance;
  }

  .about-leadership__body > p {
    margin: 0 0 1.45rem;
    max-width: 49ch;
    font-size: clamp(1rem, 1.25vw, 1.17rem);
    line-height: 1.72;
    color: color-mix(in srgb, var(--ink) 86%, transparent);
  }

  .about-leadership__body .about-leadership__opening {
    margin-bottom: 2.2rem;
    font-size: clamp(1.55rem, 2.6vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -.035em;
    line-height: 1.14;
    color: var(--ink);
  }

  .perspective {
    overflow: hidden;
    padding-block: clamp(5rem, 14vh, 11rem);
    background: var(--primary-surface);
    color: var(--primary-surface-cream);
  }

  .perspective .label {
    color: var(--primary-surface-ink);
  }

  .perspective__headline {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, .65fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
  }

  .perspective__headline h2 {
    max-width: 12ch;
    font-size: clamp(2.65rem, 3.8vw, 4.25rem);
    line-height: .98;
    letter-spacing: -.04em;
    text-wrap: balance;
  }

  .perspective__standfirst {
    margin: 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--amber);
    font-size: clamp(1.35rem, 2.2vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.2;
  }

  .perspective__story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, .72fr);
    gap: clamp(3rem, 9vw, 9rem);
    margin-top: clamp(4rem, 10vh, 8rem);
    align-items: start;
  }

  .perspective__copy {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 3rem;
  }

  .perspective__copy p {
    margin: 0;
    font-size: clamp(1rem, 1.25vw, 1.17rem);
    line-height: 1.68;
  }

  .perspective__copy strong {
    color: var(--ink);
  }

  .perspective__principle {
    position: relative;
    padding: clamp(2rem, 4vw, 3.5rem);
    background: var(--ink);
    color: var(--cream);
    border-top: 3px solid var(--amber);
  }

  .perspective__principle > span {
    display: block;
    margin-bottom: clamp(3rem, 8vh, 6rem);
    color: var(--amber);
    font-size: var(--micro-size);
    font-weight: 700;
    letter-spacing: .18em;
  }

  .perspective__principle p,
  .perspective__principle strong {
    display: block;
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 3.2rem);
    letter-spacing: -.045em;
    line-height: 1.02;
  }

  .perspective__principle p {
    color: var(--sage-pale);
    font-weight: 400;
  }

  .perspective__principle strong {
    margin-top: 1.2rem;
    font-weight: 600;
  }

  .industries {
    margin-top: clamp(4rem, 11vh, 9rem);
    padding-top: clamp(2rem, 5vh, 4rem);
    border-top: 1px solid color-mix(in srgb, var(--cream) 24%, transparent);
  }

  .industries__heading {
    display: grid;
    grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr);
    gap: 2rem;
    align-items: start;
  }

  .industries__heading .label {
    margin: 0;
  }

  .industries__heading > p:last-child {
    margin: 0;
    max-width: 32ch;
    font-size: clamp(1.25rem, 2vw, 2rem);
    letter-spacing: -.025em;
    line-height: 1.25;
  }

  .industries__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(3rem, 7vh, 5rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--cream) 23%, transparent);
  }

  .industries__list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: .85rem;
    min-height: 6.2rem;
    padding: 1.15rem 1rem 1.15rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 23%, transparent);
    font-size: clamp(.9rem, 1.08vw, 1.05rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .industries__list li span {
    color: var(--primary-surface-ink);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .industries__closing {
    max-width: 88ch;
    margin: clamp(3rem, 7vh, 5rem) 0 0;
    padding-left: clamp(1.5rem, 4vw, 3rem);
    border-left: 2px solid var(--amber);
    font-size: clamp(1.05rem, 1.45vw, 1.3rem);
    line-height: 1.65;
  }

  .industries__closing strong {
    color: var(--ink);
  }

  .expectations {
    padding-block: clamp(4.5rem, 10vh, 8rem);
  }

  .expectations__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, .55fr);
    grid-template-areas:
      "label copy"
      "title copy";
    column-gap: clamp(3rem, 8vw, 8rem);
    row-gap: clamp(1.25rem, 2.5vh, 2rem);
    align-items: start;
  }

  .expectations__heading .label {
    grid-area: label;
    align-self: start;
    margin: 0;
  }

  .expectations__heading h2 {
    grid-area: title;
    max-width: 16ch;
    font-size: clamp(2.65rem, 3.8vw, 4.25rem);
    line-height: .98;
    letter-spacing: -.04em;
    text-wrap: balance;
  }

  .expectations__heading > p:last-child {
    grid-area: copy;
    align-self: end;
    justify-self: end;
    max-width: 34ch;
    margin: 0;
    padding-left: 1.4rem;
    border-left: 2px solid var(--amber);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.62;
  }

  .expectations__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: clamp(4rem, 9vh, 7rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .expectation {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.2rem, 3vw, 2.4rem);
    padding: clamp(1.8rem, 4vw, 3rem) clamp(1.2rem, 3vw, 2.5rem) clamp(1.8rem, 4vw, 3rem) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .expectation:nth-child(odd) {
    border-right: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .expectation:nth-child(even) {
    padding-left: clamp(1.2rem, 3vw, 2.5rem);
  }

  .expectation__number {
    color: var(--ochre);
    font-size: var(--micro-size);
    font-weight: 700;
    letter-spacing: .18em;
  }

  .expectation h3 {
    margin: 0;
    font-size: clamp(1.3rem, 2vw, 2rem);
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: 1.1;
  }

  .expectation p {
    max-width: 48ch;
    margin: 1rem 0 0;
    font-size: clamp(.98rem, 1.1vw, 1.08rem);
    line-height: 1.65;
    color: color-mix(in srgb, var(--ink) 82%, transparent);
  }

	:global(#guest-lectures) {
		background: var(--tan);
		padding-top: clamp(3rem, 8vh, 6rem);
		padding-bottom: 0;
	}

  :global(#guest-lectures .mq--logos) {
    background: var(--tan);
  }

  @media (min-width: 801px) {
    .about-hero__title-line,
    .about-heading__line {
      display: block;
    }

    .about-hero__portrait-frame::after {
      background: linear-gradient(
        180deg,
        transparent 52%,
        color-mix(in srgb, var(--ink) 28%, transparent) 72%,
        color-mix(in srgb, var(--ink) 88%, transparent) 100%
      );
    }

    .about-hero__portrait figcaption {
      text-shadow: 0 2px 14px color-mix(in srgb, var(--ink) 88%, transparent);
    }

    .perspective {
      padding-block: clamp(4.5rem, 10vh, 8rem);
    }

    .perspective__headline {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, .55fr);
      gap: clamp(3rem, 6vw, 6rem);
    }

    .perspective__headline h2 {
      max-width: 14ch;
      font-size: clamp(2.65rem, 3.8vw, 4.25rem);
      line-height: .98;
      letter-spacing: -.04em;
    }

    .perspective__standfirst {
      font-size: clamp(1.25rem, 1.8vw, 1.75rem);
    }

    .perspective__story {
      margin-top: clamp(3rem, 7vh, 5rem);
    }

    .perspective__principle {
      padding: clamp(2rem, 3vw, 3rem);
    }

    .perspective__principle > span {
      margin-bottom: clamp(1.75rem, 3vh, 2.5rem);
    }

    .perspective__principle p {
      font-size: clamp(1.35rem, 2vw, 2rem);
      line-height: 1.14;
    }

    .perspective__principle strong {
      margin-top: clamp(1.25rem, 2.5vh, 1.75rem);
      padding-top: clamp(1.25rem, 2.5vh, 1.75rem);
      border-top: 1px solid color-mix(in srgb, var(--cream) 24%, transparent);
      font-size: clamp(1.45rem, 2.1vw, 2.1rem);
      line-height: 1.08;
    }
  }

  @media (min-width: 1100px) {
    .about-leadership__heading .about-heading__line:first-child {
      white-space: nowrap;
    }

    .expectations__heading h2 {
      max-width: none;
    }

    .expectations__heading .about-heading__line:nth-child(2) {
      white-space: nowrap;
    }
  }

  @media (max-width: 1050px) {
    .about-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, .62fr);
      gap: 3rem;
    }

    .perspective__copy {
      grid-template-columns: 1fr;
    }

    .industries__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

  @media (max-width: 800px) {
    .about-hero {
